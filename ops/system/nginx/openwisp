# OpenWISP — wisp.sabiwifi.com
# Proxies to docker-openwisp nginx container on port 8081
# SSL via Let's Encrypt (cert auto-renewed by certbot)

server {
    listen 80;
    server_name wisp.sabiwifi.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name wisp.sabiwifi.com;

    ssl_certificate     /etc/letsencrypt/live/wisp.sabiwifi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wisp.sabiwifi.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Proxy upstream is OpenWISP container nginx with self-signed cert
    proxy_ssl_verify off;

    location = / {
        return 302 /admin/;
    }

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        client_max_body_size 100M;
    }

    location /ws/ {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
    }
}
