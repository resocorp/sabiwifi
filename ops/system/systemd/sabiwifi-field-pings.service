[Unit]
Description=SabiWiFi — ping field techs on stale tickets, escalate after max pings
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/sabiwifi
ExecStart=/opt/sabiwifi/venv/bin/python manage.py sweep_field_pings
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
EnvironmentFile=/opt/sabiwifi/.env
StandardOutput=journal
StandardError=journal
