[Unit]
Description=SabiWiFi — process queued broadcast campaigns
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/sabiwifi
ExecStart=/opt/sabiwifi/venv/bin/python manage.py process_broadcasts
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
EnvironmentFile=/opt/sabiwifi/.env
StandardOutput=journal
StandardError=journal
