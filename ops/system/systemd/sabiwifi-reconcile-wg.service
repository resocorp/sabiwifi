[Unit]
Description=SabiWiFi — reconcile WireGuard peers from database
# Must run after the DB is up (we read the Router table) and after wg0
# is up (we call `wg syncconf`). Runs before the Django app so the peer
# set is authoritative by the time the first heartbeat arrives.
After=postgresql.service wg-quick@wg0.service
Requires=wg-quick@wg0.service
Before=sabiwifi.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/sabiwifi
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"
ExecStart=/opt/sabiwifi/venv/bin/python manage.py reconcile_wg
# Don't block boot if a transient reconcile fails — the next timer/manual
# run will re-attempt. sabiwifi.service is still useful without it.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
