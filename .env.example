# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=app.sabiwifi.com,localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=sabiwifi
DB_USER=sabiwifi
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Termii (SMS + OTP)
TERMII_API_KEY=your-termii-api-key
TERMII_SECRET=your-termii-secret-key
TERMII_SENDER_ID=SabiWiFi

# Server (for WireGuard provisioning)
SERVER_IP=154.12.34.56
SERVER_WG_PUBLIC_KEY=your-server-wg-public-key

# Platform
PLATFORM_DOMAIN=app.sabiwifi.com

# WhatsApp sidecar (shared secret with /opt/sabiwifi-wa Node service)
WA_API_KEY=generate-with-openssl-rand-base64-32

# OpenWISP webhook (shared secret with wisp.sabiwifi.com)
OPENWISP_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Fernet key for encrypting per-reseller AI prompt overrides and other secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_FERNET_KEY=generate-fernet-key

# Voice droplet (avr-llm-sabiwifi bridge → Django /api/ai/voice-turn/)
VOICE_API_KEY=generate-with-openssl-rand-base64-32
VOICE_SERVICE_URL=http://voice-droplet-ip:8088
